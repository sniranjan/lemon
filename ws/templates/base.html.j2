<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ sheet.id }}</title>
<style>
@font-face { font-family: "Andika"; font-weight: 400; src: url("{{ root }}/assets/fonts/Andika-Regular.ttf"); }
@font-face { font-family: "Andika"; font-weight: 700; src: url("{{ root }}/assets/fonts/Andika-Bold.ttf"); }
@page { size: letter; margin: 0; }
:root {
  --accent: {{ theme.accent }};
  --tint: {{ theme.tint }};
  --ink: #1d1d1f;
  --muted: #6b6b70;
}
* { box-sizing: border-box; }
html, body { margin: 0; background: #fff; }
/* no ligatures: early readers should see every letter (fi, fl, ff) separately */
body { font-family: "Andika", sans-serif; font-variant-ligatures: none; font-feature-settings: "liga" 0, "clig" 0; color: var(--ink); -webkit-print-color-adjust: exact; print-color-adjust: exact; }

.page { width: 816px; height: 1056px; padding: 48px 56px 40px; display: flex; flex-direction: column; overflow: hidden; }

/* header */
.head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px;
        padding-bottom: 14px; border-bottom: 3px solid var(--accent); }
.eyebrow { font-size: 14px; font-weight: 700; letter-spacing: 0.14em; color: var(--accent); text-transform: uppercase; }
.title-row { display: flex; align-items: center; gap: 14px; margin-top: 4px; }
h1 { font-size: 34px; font-weight: 700; margin: 0; line-height: 1.15; }
.pill { font-size: 16px; font-weight: 700; color: var(--accent); background: var(--tint);
        border: 2px solid var(--accent); border-radius: 999px; padding: 3px 14px; white-space: nowrap; }
.fields { font-size: 15px; color: var(--muted); display: grid; gap: 9px; text-align: left; }
.fields span { display: inline-block; width: 44px; }
.fields i { display: inline-block; width: 128px; border-bottom: 1.5px solid #9a9aa0; height: 1em; vertical-align: baseline; }

/* parent tip */
.tip { margin-top: 18px; background: var(--tint); border: 2px solid var(--accent); border-radius: 14px; padding: 12px 18px; font-size: 17px; line-height: 1.4; }
.tip b { color: var(--accent); }

/* the body fills whatever height the header, tip, strip and footer leave */
.body { flex: 1; min-height: 0; display: flex; flex-direction: column; margin-top: 20px; }

/* cards */
.card { border: 3px solid var(--ink); border-radius: 28px; background: #fff; overflow: hidden; }

/* "Say it again" strip */
.strip { margin-top: 18px; border: 3px dashed var(--accent); border-radius: 22px; padding: 10px 24px;
         display: flex; align-items: center; gap: 28px; overflow: hidden; }
.strip-label { font-size: 17px; font-weight: 700; color: var(--accent); width: 96px; line-height: 1.2; }
.strip-item { display: flex; align-items: center; gap: 14px; flex: 1; }
.strip-item img { width: 84px; height: 84px; }
.strip-item .word { font-size: 36px; font-weight: 700; }

.foot { margin-top: 14px; font-size: 12px; color: #8a8a90; text-align: right; }
{% block style %}{% endblock %}
</style>
</head>
<body>
<div class="page">
  <header class="head">
    <div>
      <div class="eyebrow">Level {{ level.level }} · {{ theme.label }}</div>
      <div class="title-row"><h1>{{ sheet.title }}</h1><span class="pill">{{ level.level }} · {{ sheet.page_number }}</span></div>
    </div>
    <div class="fields">
      <div><span>Name</span><i></i></div>
      <div><span>Date</span><i></i></div>
      <div><span>Time</span><i></i></div>
    </div>
  </header>
  <div class="tip"><b>For grown-ups:</b> {{ sheet.parent_tip }}</div>
  <main class="body">
{% block body %}{% endblock %}
  </main>
{% block after_body %}{% endblock %}
  <footer class="foot">{{ sheet.id }}</footer>
</div>
</body>
</html>
