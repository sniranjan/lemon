{% extends "base.html.j2" %}
{% import "_fractions.html.j2" as fr %}
{# Dividing fractions. `model` rows: the problem, then whole bars cut into pieces the size of the
   divisor, with the dividend's pieces shaded, so the child counts how many fit. `facts`: two
   columns of problems with an answer box big enough for a mixed number. #}
{% set model = sheet.items[0].bar is defined %}
{% block style %}
{{ fr.style(30) }}
.probs { flex: 1; min-height: 0; display: grid; gap: 14px 18px;
         grid-template-columns: {{ "1fr" if model else "1fr 1fr" }}; grid-auto-rows: 1fr; }
.probs .card { position: relative; min-height: 0; display: flex; align-items: center; gap: 26px; padding: 8px 22px 8px 34px; border-radius: 22px; }
.qn { position: absolute; top: 10px; left: 12px; font-size: 13px; font-weight: 700; color: #8a8a90; }
.eq { {% if model %}min-width: 300px; {% endif %}display: flex; align-items: center; gap: 9px; font-size: 38px; font-weight: 700; white-space: nowrap; }
.ans { width: 86px; height: 82px; border: 3px solid var(--ink); border-radius: 12px; background: #fff; flex: none; }
.bars { flex: 1; display: flex; flex-direction: column; gap: 8px; }
.bar { display: flex; height: 28px; border: 3px solid var(--ink); border-radius: 5px; overflow: hidden; }
.bar i { flex: 1; border-left: 2px solid var(--ink); background: #fff; }
.bar i:first-child { border-left: 0; }
.bar i.on { background: repeating-linear-gradient(45deg, #fff 0 4px, var(--accent) 4px 7px); }
{% endblock %}
{% block body %}
    <div class="probs">
{% for p in sheet.items %}
      <div class="card"><span class="qn" data-audience="parent">{{ p.n }}</span>
        <div class="eq">{{ fr.number(p.a) }}<span>÷</span>{{ fr.number(p.b) }}<span>=</span><span class="ans"></span></div>
{% if model %}
        <div class="bars">
{% for bar in range(p.bar.bars) %}
          <div class="bar">{% for k in range(p.bar.pieces) %}<i{% if bar * p.bar.pieces + k < p.bar.shaded %} class="on"{% endif %}></i>{% endfor %}</div>
{% endfor %}
        </div>
{% endif %}
      </div>
{% endfor %}
    </div>
{% endblock %}
