{# Count pictures: up to 5 in one row, 6–10 as two rows of five (ten-frame style). #}
{% macro objects(n, picture, size) %}
<div class="objects" style="--obj: {{ size }}px">
{% for row in range(0, n, 5) %}
  <div class="obj-row">{% for _ in range(row, [row + 5, n] | min) %}<img src="{{ root }}/assets/pictures/{{ picture }}.svg" alt="">{% endfor %}</div>
{% endfor %}
</div>
{% endmacro %}

{# A drawn arrow pointing right (no font glyph): "this number, then the next one". #}
{% macro arrow(width=64) %}<svg class="arrow" viewBox="0 0 64 32" width="{{ width }}" height="{{ width // 2 }}" aria-hidden="true"><path d="M4 16 H50" stroke="#1d1d1f" stroke-width="5" stroke-linecap="round"/><path d="M40 5 L58 16 L40 27" fill="none" stroke="#1d1d1f" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endmacro %}
