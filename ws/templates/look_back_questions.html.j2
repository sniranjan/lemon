{% extends "base.html.j2" %}
{% import "_long_read.html.j2" as lr %}
{% block style %}
{{ lr.style() }}
.back { display: flex; align-items: center; gap: 14px; font-size: 20px; line-height: 1.3; border: 3px solid var(--ink);
        border-radius: 18px; padding: 10px 18px; }
.back svg { flex: none; }
{% endblock %}
{% block body %}
    <div class="card fit">
{% set head = sheet.items[0] %}
    <div class="back"><svg width="34" height="28" viewBox="0 0 34 28" aria-hidden="true"><path d="M31 14 H6 M14 5 L5 14 L14 23" fill="none" stroke="#1d1d1f" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Look back at page {{ head.back_page }}{% if head.get("story") %}, chapter {{ head.chapter }} of <b>{{ head.story }}</b>{% elif head.get("texts") %}, <b>{{ head.heading }}</b>. Some questions need both texts{% else %}, <b>{{ head.heading }}</b>{% endif %}. Find the words that show each answer.</span></div>
    <div class="qs">
{% for q in sheet.items[1:] %}
{{ lr.question(q) }}
{% endfor %}
    </div>
    </div>
{% endblock %}
