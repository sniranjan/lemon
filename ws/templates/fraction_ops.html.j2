{% extends "base.html.j2" %}
{# Fraction problems with stacked fractions (never slashes). list: 8 problems, 2 columns, room below
   each to rename the fractions. model (dividing, Pandas): 5 rows, each with fraction bars to count on. area: 4 problems, each over a unit square cut into columns (first
   fraction's denominator) and rows (second's), the two fractions shaded with crossing stripes. #}
{% set layout = sheet.items[0].layout %}
{% macro num(o) %}<span class="opnd">{% if o.whole or not o.num %}<span class="whole">{{ o.whole }}</span>{% endif %}{% if o.num %}<span class="fr"><span>{{ o.num }}</span><span class="bar"></span><span>{{ o.den }}</span></span>{% endif %}</span>{% endmacro %}
{% macro eqn(i) %}<div class="eqn">{{ num(i.a) }}<span class="op">{{ i.sign }}</span>{{ num(i.b) }}<span class="op">=</span><span class="ans"></span></div>{% endmacro %}
{% block style %}
.problems { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px 18px; }
.list { grid-template-rows: repeat({{ (sheet.items | length + 1) // 2 }}, 1fr); grid-auto-flow: column; }
.area { grid-template-rows: 1fr 1fr; }
.problems .card { position: relative; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 22px 12px 10px; border-radius: 22px; }
.qn { position: absolute; top: 8px; left: 14px; font-size: 13px; font-weight: 700; color: #8a8a90; }
.eqn { display: flex; align-items: center; gap: 12px; font-weight: 700; line-height: 1; }
.opnd { display: inline-flex; align-items: center; gap: 4px; }
.whole { font-size: 42px; }
.fr { display: inline-flex; flex-direction: column; align-items: center; font-size: 30px; line-height: 1.05; }
.fr .bar { width: 100%; min-width: 30px; border-top: 3px solid var(--ink); margin: 3px 0; }
.op { font-size: 36px; color: var(--accent); }
.ans { display: inline-block; width: 92px; height: 86px; border: 3px solid var(--ink); border-radius: 12px; background: #fff; }
.work { margin-top: auto; width: 88%; border-bottom: 2px dashed #c9c9ce; height: 1px; }
.area .card { justify-content: space-around; padding-top: 16px; }
.area .ans { height: 82px; }
{% if layout == "model" %}
/* dividing (Pandas math): one problem a row with whole bars cut into divisor-sized pieces */
.model { grid-template-columns: 1fr; grid-auto-rows: 1fr; }
.model .card { flex-direction: row; align-items: center; justify-content: flex-start; gap: 26px; padding: 8px 22px 8px 34px; }
.model .eqn { min-width: 320px; }
.bars { flex: 1; display: flex; flex-direction: column; gap: 8px; }
.pbar { display: flex; height: 28px; border: 3px solid var(--ink); border-radius: 5px; overflow: hidden; }
.pbar i { flex: 1; border-left: 2px solid var(--ink); background: #fff; }
.pbar i:first-child { border-left: 0; }
.pbar i.on { background: repeating-linear-gradient(45deg, #fff 0 4px, var(--accent) 4px 7px); }
{% endif %}
{% endblock %}
{% block body %}
    <div class="problems {{ layout }}">
{% for i in sheet.items %}
      <div class="card"><span class="qn" data-audience="parent">{{ i.n }}</span>
{% if layout == "area" %}
{% set S = 216 %}
        <svg width="{{ S + 8 }}" height="{{ S + 8 }}" viewBox="-4 -4 {{ S + 8 }} {{ S + 8 }}">
          <defs>
            <pattern id="cols{{ i.n }}" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="10" height="10" fill="{{ theme.tint }}"/><line x1="0" y1="0" x2="0" y2="10" stroke="{{ theme.accent }}" stroke-width="4"/></pattern>
            <pattern id="rows{{ i.n }}" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)"><line x1="0" y1="0" x2="0" y2="10" stroke="#1d1d1f" stroke-width="2.5"/></pattern>
          </defs>
          <rect x="0" y="0" width="{{ (S * i.a.num / i.a.den) | round(2) }}" height="{{ S }}" fill="url(#cols{{ i.n }})"/>
          <rect x="0" y="0" width="{{ S }}" height="{{ (S * i.b.num / i.b.den) | round(2) }}" fill="url(#rows{{ i.n }})"/>
{% for k in range(1, i.a.den) %}
          <line x1="{{ (S * k / i.a.den) | round(2) }}" x2="{{ (S * k / i.a.den) | round(2) }}" y1="0" y2="{{ S }}" stroke="#1d1d1f" stroke-width="2"/>
{% endfor %}
{% for k in range(1, i.b.den) %}
          <line x1="0" x2="{{ S }}" y1="{{ (S * k / i.b.den) | round(2) }}" y2="{{ (S * k / i.b.den) | round(2) }}" stroke="#1d1d1f" stroke-width="2"/>
{% endfor %}
          <rect x="0" y="0" width="{{ S }}" height="{{ S }}" fill="none" stroke="#1d1d1f" stroke-width="4"/>
        </svg>
        {{ eqn(i) }}
{% elif layout == "model" %}
        {{ eqn(i) }}
        <div class="bars">
{% for bar in range(i.bar.bars) %}
          <div class="pbar">{% for k in range(i.bar.pieces) %}<i{% if bar * i.bar.pieces + k < i.bar.shaded %} class="on"{% endif %}></i>{% endfor %}</div>
{% endfor %}
        </div>
{% else %}
        {{ eqn(i) }}
        <div class="work"></div>
{% endif %}
      </div>
{% endfor %}
    </div>
{% endblock %}
