{# Owls Reading long reads (long_read_page, look_back_questions, word_detective, big_idea_summary). #}
{% macro style() %}
h1 { font-size: 28px; }
/* everything in the body sits in .fit: the layout check flags anything that spills past it */
.fit { border: 0; border-radius: 0; flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: hidden; padding-top: 8px; margin-top: -8px; }
.read-wrap { flex: none; position: relative; margin-top: 6px; }
.read-wrap .how { position: absolute; z-index: 1; top: -13px; left: 22px; background: #fff; padding: 0 10px;
                  font-size: 20px; line-height: 24px; font-weight: 700; color: var(--accent); }
.read { padding: 16px 26px 8px; border-radius: 22px; }
.read p { font-size: 20px; line-height: 1.28; margin: 0 0 4px; text-indent: 1.4em; }
.read h2 { font-size: 22px; line-height: 1.2; margin: 8px 0 4px; color: var(--accent); }
.read h2:first-child { margin-top: 2px; }
.read b { font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
.text-head { display: flex; align-items: baseline; gap: 12px; margin: 2px 0 6px; }
.text-head .badge { flex: none; font-size: 20px; font-weight: 700; color: #fff; background: var(--accent); border-radius: 999px; padding: 0 12px; }
.text-head .t { font-size: 22px; font-weight: 700; }
.text-head .k { font-size: 20px; color: #4a4a50; font-style: italic; }
.read + .read { margin-top: 18px; }
/* figures: drawn from data, all text 20px */
.fig { margin: 10px 0 8px; border: 2px dashed var(--accent); border-radius: 16px; padding: 8px 14px 6px; font-size: 20px; }
.fig .ft { font-weight: 700; line-height: 1.2; margin-bottom: 6px; }
.fig .cap { font-style: italic; color: #3a3a40; line-height: 1.25; margin-top: 6px; }
.steps { display: flex; align-items: center; gap: 4px; }
.steps .box { flex: 1; min-width: 0; border: 2px solid var(--ink); border-radius: 12px; padding: 4px 6px; text-align: center; line-height: 1.15; background: var(--tint); }
.steps svg { flex: none; }
.cycle-back { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 4px; font-weight: 700; color: var(--accent); }
.fig table { border-collapse: collapse; width: 100%; }
.fig th, .fig td { border: 2px solid var(--ink); padding: 2px 10px; text-align: left; line-height: 1.2; }
.fig th { background: var(--tint); }
.bars .row { display: flex; align-items: center; gap: 10px; margin: 3px 0; }
.bars .lab { flex: none; width: 190px; line-height: 1.15; }
.bars .track { flex: 1; display: flex; align-items: center; gap: 8px; }
.bars .bar { height: 22px; background: var(--accent); border: 2px solid var(--ink); border-radius: 4px; }
.bars .num { font-weight: 700; white-space: nowrap; }
.tl .row { display: flex; gap: 14px; align-items: baseline; line-height: 1.2; margin: 2px 0; }
.tl .when { flex: none; width: 110px; font-weight: 700; text-align: right; }
.tl .dot { flex: none; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); border: 2px solid var(--ink); align-self: center; }
/* questions */
.qs { flex: 1 0 auto; display: flex; flex-direction: column; justify-content: space-evenly; gap: 4px; margin-top: 4px; }
.q .ask { font-size: 20px; font-weight: 700; line-height: 1.3; display: flex; gap: 10px; }
.q .ask b { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
.q .num { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--ink); color: #fff;
          display: inline-flex; align-items: center; justify-content: center; font-size: 20px; }
.q .choices { display: flex; flex-wrap: wrap; column-gap: 26px; row-gap: 2px; margin: 4px 0 0 40px; font-size: 20px; }
.q .choice { display: flex; align-items: center; gap: 8px; }
.q .letter { flex: none; width: 29px; height: 29px; border: 2px solid var(--ink); border-radius: 50%;
             display: inline-flex; align-items: center; justify-content: center; font-weight: 700; }
.q .line { height: 40px; margin-left: 40px; border-bottom: 2px solid #8a8a90; display: flex; align-items: flex-end; padding-bottom: 3px; }
.q .starter { font-size: 20px; color: #4a4a50; }
{% endmacro %}

{% macro arrow() %}<svg width="26" height="20" viewBox="0 0 26 20" aria-hidden="true"><path d="M2 10 H20 M14 4 L21 10 L14 16" fill="none" stroke="#1d1d1f" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endmacro %}

{% macro figure(f) %}
      <figure class="fig" style="margin-left:0;margin-right:0">
        <div class="ft">{{ f.title }}</div>
{% if f.kind in ("steps", "cycle") %}
        <div class="steps">{% for s in f["items"] %}{% if not loop.first %}{{ arrow() }}{% endif %}<div class="box">{{ s }}</div>{% endfor %}</div>
{% if f.kind == "cycle" %}
        <div class="cycle-back"><svg width="34" height="22" viewBox="0 0 34 22" aria-hidden="true"><path d="M30 4 C30 18 6 18 6 8 M1 12 L6 6 L11 12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Then it starts again.</span></div>
{% endif %}
{% elif f.kind == "table" %}
        <table><tr>{% for c in f.columns %}<th>{{ c }}</th>{% endfor %}</tr>
{% for r in f.rows %}
          <tr>{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>
{% endfor %}
        </table>
{% elif f.kind == "bars" %}
        <div class="bars">
{% for r in f.rows %}
          <div class="row"><span class="lab">{{ r[0] }}</span><span class="track"><span class="bar" style="width: {{ (f.widths[loop.index0] * 0.7)|round(1) }}%"></span><span class="num">{{ r[1] }} {{ f.unit }}</span></span></div>
{% endfor %}
        </div>
{% else %}
        <div class="tl">
{% for r in f.rows %}
          <div class="row"><span class="when">{{ r[0] }}</span><span class="dot"></span><span>{{ r[1] }}</span></div>
{% endfor %}
        </div>
{% endif %}
        <figcaption class="cap">{{ f.caption }}</figcaption>
      </figure>
{% endmacro %}

{% macro rich(text, targets) %}{% for piece, bold in split_targets(text, targets) %}{% if bold %}<b>{{ piece }}</b>{% else %}{{ piece }}{% endif %}{% endfor %}{% endmacro %}

{% macro blocks(bs, targets=[], fig=None) %}
{% for b in bs %}
{% if "h" in b %}
      <h2>{{ b.h }}</h2>
{% else %}
      <p>{{ rich(b.p, targets) }}</p>
{% endif %}
{% endfor %}
{% if fig %}
{{ figure(fig) }}
{% endif %}
{% endmacro %}

{% macro label(item) %}
{%- if item.get("texts") %}Read both texts.{% elif item.get("story") %}Read chapter {{ item.chapter }} of {{ item.story }}.{% elif item.type == "article" %}Read the article.{% else %}Read the story.{% endif %}
{%- endmacro %}

{% macro read_card(item, how) %}
{% if item.get("texts") %}
{% for t in item.texts %}
    <section class="read-wrap">
{% if loop.first %}
      <div class="how">{{ how }}</div>
{% endif %}
      <div class="card read">
        <div class="text-head"><span class="badge">Text {{ loop.index }}</span><span class="t">{{ t.title }}</span><span class="k">{{ t.type }}</span></div>
{{ blocks(t.blocks) }}
      </div>
    </section>
{% endfor %}
{% else %}
    <section class="read-wrap">
      <div class="how">{{ how }}</div>
      <div class="card read">
{{ blocks(item.blocks, item.get("targets", []), item.get("figure")) }}
      </div>
    </section>
{% endif %}
{% endmacro %}

{% macro question(q, targets=[]) %}
      <div class="q">
        <div class="ask"><span class="num">{{ q.n }}</span><span>{{ rich(q.ask, targets) }}</span></div>
{% if q.kind == "mc" %}
        <div class="choices">{% for c in q.choices %}<span class="choice"><span class="letter">{{ "ABC"[loop.index0] }}</span>{{ c }}</span>{% endfor %}</div>
{% else %}
{% for _ in range(q.lines) %}
        <div class="line">{% if loop.first and q.get("starter") %}<span class="starter">{{ q.starter }}</span>{% endif %}</div>
{% endfor %}
{% endif %}
      </div>
{% endmacro %}
