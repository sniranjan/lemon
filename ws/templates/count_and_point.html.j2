{% extends "base.html.j2" %}
{% from "_macros.html.j2" import objects with context %}
{% block style %}
.rows { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 20px; }
.rows .card { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: space-between; padding: 12px 24px; }
.choices { display: flex; gap: 12px; }
.choice { width: 64px; height: 64px; border: 3px solid var(--ink); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 40px; font-weight: 700; }
{% endblock %}
{% block body %}
    <div class="rows">
{% for item in sheet.items %}
      <div class="card">{{ objects(item.n, item.picture, 72) }}<div class="choices">{% for c in item.choices %}<div class="choice">{{ c }}</div>{% endfor %}</div></div>
{% endfor %}
    </div>
{% endblock %}
