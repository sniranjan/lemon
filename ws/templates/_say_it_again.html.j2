{% set strip = sheet.items | selectattr("kind", "equalto", "strip") | list %}
{% if strip %}
  <section class="strip">
    <div class="strip-label">Say it again</div>
{% for item in strip %}
    <div class="strip-item"><img src="{{ root }}/assets/pictures/{{ item.picture }}.svg" alt=""><span class="word">{{ item.word }}</span></div>
{% endfor %}
  </section>
{% endif %}
