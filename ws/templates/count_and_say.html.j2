{% extends "base.html.j2" %}
{% from "_macros.html.j2" import objects with context %}
{% block style %}
.rows { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 20px; }
.rows .card { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: space-between; padding: 12px 36px; }
.answer { display: flex; flex-direction: column; align-items: center; min-width: 150px; }
.numeral { font-size: 104px; font-weight: 700; line-height: 1; }
.numword { font-size: 36px; font-weight: 700; color: var(--accent); }
{% endblock %}
{% block body %}
    <div class="rows">
{% for item in sheet.items %}
      <div class="card">{{ objects(item.n, item.picture, 72) }}<div class="answer"><div class="numeral">{{ item.n }}</div><div class="numword">{{ item.word }}</div></div></div>
{% endfor %}
    </div>
{% endblock %}
