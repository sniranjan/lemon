<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc_title }}</title>
<style>
@font-face { font-family: "Andika"; font-weight: 400; src: url("{{ root }}/assets/fonts/Andika-Regular.ttf"); }
@font-face { font-family: "Andika"; font-weight: 700; src: url("{{ root }}/assets/fonts/Andika-Bold.ttf"); }
/* logo fonts: the same files as the website wordmark (assets/fonts/brand) */
@font-face { font-family: "Fredoka"; font-weight: 700; src: url("{{ root }}/assets/fonts/brand/Fredoka-Bold.woff2") format("woff2"); }
@font-face { font-family: "Gochi Hand"; font-weight: 400; src: url("{{ root }}/assets/fonts/brand/GochiHand-Regular.woff2") format("woff2"); }
/* wordmark, matching apps/web/src/components/Logo.tsx: ink #1f2a44, coral #ff6b5e */
.brand { display: flex; align-items: center; gap: 0.3em; line-height: 1; white-space: nowrap; }
.brand .paper { font-family: "Fredoka", sans-serif; font-weight: 700; letter-spacing: -0.025em; color: #1f2a44; }
.brand .lessons { font-family: "Gochi Hand", cursive; font-weight: 400; color: #ff6b5e; font-size: 1.12em;
                  display: inline-block; transform: translateY(0.06em) rotate(-3deg); }
@page { size: letter; margin: 0; }
:root { --accent: {{ theme.accent }}; --tint: {{ theme.tint }}; --ink: #1d1d1f; --muted: #6b6b70; }
* { box-sizing: border-box; }
html, body { margin: 0; background: #fff; }
body { font-family: "Andika", sans-serif; font-variant-ligatures: none; color: var(--ink);
       -webkit-print-color-adjust: exact; print-color-adjust: exact; }
.page { width: 816px; height: 1056px; padding: 48px 56px 40px; display: flex; flex-direction: column; overflow: hidden; break-after: page; }
.page:last-child { break-after: auto; }
.eyebrow { font-size: 14px; font-weight: 700; letter-spacing: 0.14em; color: var(--accent); text-transform: uppercase; }
h1 { font-size: 34px; margin: 4px 0 0; line-height: 1.15; }
.rule { border-bottom: 3px solid var(--accent); padding-bottom: 14px; }
.tip { background: var(--tint); border: 2px solid var(--accent); border-radius: 14px; padding: 12px 18px; font-size: 17px; line-height: 1.4; }
.tip b { color: var(--accent); }
.foot { margin-top: auto; font-size: 12px; color: #8a8a90; text-align: right; }
table { border-collapse: collapse; width: 100%; }
th { text-align: left; font-size: 16px; color: var(--accent); border-bottom: 3px solid var(--accent); padding: 8px 10px; }
td { border-bottom: 1.5px solid #b8b8be; padding: 0 10px; font-size: 17px; }
{% block style %}{% endblock %}
</style>
</head>
<body data-audience="parent">
{% block pages %}{% endblock %}
</body>
</html>
