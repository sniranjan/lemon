{% extends "booklet/_doc.html.j2" %}
{% block style %}
td { height: 34px; }
.c-page { width: 18%; }
{% endblock %}
{% block pages %}
{% for chunk in rows | batch(20) %}
<div class="page">
  <div class="rule">
    <div class="eyebrow">{{ level.public_name }} · {{ theme.label }}</div>
    <h1>Answers{% if loop.length > 1 %} ({{ loop.index }} of {{ loop.length }}){% endif %}</h1>
  </div>
  <table style="margin-top: 20px;">
    <tr><th class="c-page">Page</th><th>Answers, in the order of the sheet (rows left to right, top to bottom; numbered facts follow their numbers)</th></tr>
{% for r in chunk %}
    <tr><td>Page {{ r.page }}</td><td>{{ r.answers }}</td></tr>
{% endfor %}
  </table>
  <div class="foot">{{ booklet_id }}-answers</div>
</div>
{% endfor %}
{% endblock %}
