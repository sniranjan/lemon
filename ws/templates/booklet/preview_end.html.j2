{% extends "booklet/_doc.html.j2" %}
{% from "booklet/_brand.html.j2" import brand %}
{% block style %}
.end { justify-content: center; align-items: center; text-align: center; gap: 36px; }
.end h1 { font-size: 48px; }
.end p { font-size: 24px; line-height: 1.5; max-width: 600px; margin: 0; }
.url { font-size: 40px; font-weight: 700; color: var(--accent); border: 3px solid var(--accent);
       border-radius: 999px; padding: 10px 36px; }
{% endblock %}
{% block pages %}
<div class="page end">
  {{ brand(56) }}
  <h1>Did you enjoy these pages?</h1>
  <p>The whole <b>{{ rung.public_name }}</b> level grows one small step at a time:
{% for g in groups %}{{ g.pages }} pages of {{ g.subject | lower }}{{ ", " if loop.revindex > 2 else (" and " if loop.revindex == 2 else "") }}{% endfor %}.</p>
  <div class="url">paperlessons.com</div>
  <p style="font-size: 20px; color: var(--muted);">Download the whole level, print it at home, and do a few pages a day together.</p>
</div>
{% endblock %}
