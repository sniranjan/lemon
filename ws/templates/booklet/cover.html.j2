{% extends "booklet/_doc.html.j2" %}
{% block style %}
.cover { justify-content: space-between; }
.cover .foot { margin-top: 0; }
.cover .middle { display: flex; flex-direction: column; gap: 40px; }
.big { font-size: 64px; font-weight: 700; color: var(--accent); line-height: 1; }
.name { font-size: 28px; display: flex; align-items: flex-end; gap: 16px; }
.name i { flex: 1; border-bottom: 3px solid var(--ink); height: 1.2em; }
.sections { font-size: 20px; line-height: 1.6; }
{% endblock %}
{% block pages %}
<div class="page cover">
  <div class="rule">
    <div class="eyebrow">Level {{ level.level }} · {{ theme.label }}</div>
    <h1>{{ level.title }}</h1>
  </div>
  <div class="middle">
  <div>
    <div class="big" style="font-size: 160px;">{{ level.level }}</div>
    <div style="font-size: 28px; margin-top: 12px;">Pages {{ first_page }}–{{ last_page }}{% if variant > 1 %} · version {{ variant }}{% endif %}</div>
  </div>
  <div class="sections">
{% for s in sections %}
    <div><b>{{ s.code }}</b> · {{ s.name }} · pages {{ s.first }}–{{ s.last }}</div>
{% endfor %}
  </div>
  </div>
  <div class="name">Name <i></i></div>
  <div class="tip"><b>For grown-ups:</b> About {{ level.daily_pages }} pages a day, with you beside your child.
    Move on when your child finishes 3 sheets in a row {{ pace }} without prompting.
    If it's still hard, repeat the pages with a fresh version; there's no rush.</div>
  <div class="foot">{{ booklet_id }}</div>
</div>
{% endblock %}
