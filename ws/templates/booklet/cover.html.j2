{% extends "booklet/_doc.html.j2" %}
{% from "booklet/_brand.html.j2" import brand %}
{% block style %}
.cover { justify-content: space-between; }
.cover .foot { margin-top: 0; }
.cover .middle { display: flex; flex-direction: column; gap: 40px; }
.big { font-size: 64px; font-weight: 700; color: var(--accent); line-height: 1; }
.name { font-size: 28px; display: flex; align-items: flex-end; gap: 16px; }
.name i { flex: 1; border-bottom: 3px solid var(--ink); height: 1.2em; }
.sections { font-size: 20px; line-height: 1.6; }
{% endblock %}
{% block pages %}
<div class="page cover">
  <div class="rule" style="display: flex; justify-content: space-between; align-items: flex-end; gap: 24px;">
    <div>
      <div class="eyebrow">{{ level.public_name }} · {{ theme.label }}</div>
      <h1>{{ level.public_title }}</h1>
    </div>
    {{ brand(30) }}
  </div>
  <div class="middle">
  <div>
    <div class="big" style="font-size: 120px;">{{ level.public_name }}</div>
    <div style="font-size: 28px; margin-top: 12px;">Pages {{ first_page }}–{{ last_page }}{% if variant > 1 %} · version {{ variant }}{% endif %}</div>
  </div>
  <div class="sections">
{% for s in sections %}
    <div><b>{{ s.name }}</b> · pages {{ s.first }}–{{ s.last }}</div>
{% endfor %}
  </div>
  </div>
  <div class="name">Name <i></i></div>
  <div class="tip"><b>For grown-ups:</b> A few pages a day, with you beside your child.
    Move on when your child finishes 3 sheets in a row {{ pace }} without prompting.
    If it's still hard, print those pages again and repeat them; there's no rush.
{% if color_pages %}
    <br><b>Print in color if you can:</b> pages {{ color_pages }} teach color words.
{% endif %}
  </div>
  <div class="foot">paperlessons.com · for the children in your home; please don't share this file</div>
</div>
{% endblock %}
