{% extends "base.html.j2" %}
{# Long division by a two-digit number. One grid per problem: answer boxes over the dividend's
   digits (plus an R box), the divisor and bracket, then a squared work area, two rows per answer digit. #}
{% block style %}
.problems { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 18px 20px; }
.problems .card { position: relative; min-height: 0; display: flex; align-items: flex-start; justify-content: center; padding: 30px 10px 10px; border-radius: 22px; }
.qn { position: absolute; top: 9px; left: 16px; font-size: 13px; font-weight: 700; color: #8a8a90; }
.ld { display: grid; grid-template-columns: auto 18px repeat(var(--cols), 42px) 74px; align-items: center; justify-items: center; }
.ans { width: 38px; height: 44px; border: 2px dashed var(--accent); border-radius: 8px; margin-bottom: 4px; }
.rem { justify-self: start; display: flex; align-items: center; gap: 6px; padding-left: 8px; font-size: 28px; font-weight: 700; color: var(--accent); margin-bottom: 4px; }
.rem .ans { width: 40px; margin: 0; }
.divisor { font-size: 38px; font-weight: 700; padding-right: 2px; justify-self: end; line-height: 52px; }
.paren { display: block; }
.d { font-size: 38px; font-weight: 700; line-height: 48px; height: 52px; width: 42px; text-align: center; border-top: 4px solid var(--ink); }
.w { width: 42px; height: 32px; border-right: 1px solid #c9c9ce; border-bottom: 1px solid #c9c9ce; }
.w.first { border-left: 1px solid #c9c9ce; }
{% endblock %}
{% block body %}
    <div class="problems">
{% for i in sheet.items %}
{% set digits = i.dividend | string %}
{% set cols = digits | length %}
      <div class="card"><span class="qn" data-audience="parent">{{ i.n }}</span>
        <div class="ld" style="--cols: {{ cols }}">
          <span></span><span></span>{% for c in range(cols) %}<span class="ans"></span>{% endfor %}<span class="rem">R <span class="ans"></span></span>
          <span class="divisor">{{ i.divisor }}</span><svg class="paren" width="18" height="56" viewBox="0 0 18 56"><path d="M3 2 Q 17 28 3 54" fill="none" stroke="#1d1d1f" stroke-width="4" stroke-linecap="round"/></svg>{% for ch in digits %}<span class="d">{{ ch }}</span>{% endfor %}<span></span>
{% for row in range(i.work_rows) %}
          <span></span><span></span>{% for c in range(cols) %}<span class="w{% if loop.first %} first{% endif %}"></span>{% endfor %}<span></span>
{% endfor %}
        </div>
      </div>
{% endfor %}
    </div>
{% endblock %}
