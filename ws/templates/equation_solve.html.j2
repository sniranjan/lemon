{% extends "base.html.j2" %}
{% import "_fractions.html.j2" as fr %}
{# One-step equations: the equation (fractions stacked, the letter in italics), a dashed space to
   work in, and "x = ☐" to finish. #}
{% macro val(s) %}{% if "/" in s %}{{ fr.number(s) }}{% else %}<span>{{ s }}</span>{% endif %}{% endmacro %}
{% block style %}
{{ fr.style(26) }}
.probs { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 1fr; gap: 14px 18px; }
.probs .card { position: relative; min-height: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 12px 18px 10px 34px; border-radius: 22px; }
.qn { position: absolute; top: 10px; left: 12px; font-size: 13px; font-weight: 700; color: #8a8a90; }
.eq { display: flex; align-items: center; gap: 10px; font-size: 34px; font-weight: 700; white-space: nowrap; }
.eq i { font-style: italic; }
.px { display: inline-flex; align-items: center; gap: 2px; }
.ans { align-self: flex-end; display: flex; align-items: center; gap: 8px; font-size: 28px; font-weight: 700; }
.ans i { font-style: italic; }
.box { display: inline-block; width: 96px; height: 48px; border: 3px solid var(--ink); border-radius: 10px; background: #fff; }
{% endblock %}
{% block body %}
    <div class="probs">
{% for e in sheet.items %}
      <div class="card"><span class="qn" data-audience="parent">{{ e.n }}</span>
        <div class="eq">
{% if e.form == "add" %}<i>{{ e.letter }}</i><span>+</span>{{ val(e.p) }}
{% elif e.form == "add_left" %}{{ val(e.p) }}<span>+</span><i>{{ e.letter }}</i>
{% else %}<span class="px">{{ val(e.p) }}<i>{{ e.letter }}</i></span>
{% endif %}
          <span>=</span>{{ val(e.q) }}
        </div>
        <div class="ans"><i>{{ e.letter }}</i><span>=</span><span class="box"></span></div>
      </div>
{% endfor %}
    </div>
{% endblock %}
