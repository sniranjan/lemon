{% extends "base.html.j2" %}
{# Compare pairs two to a row (a circle for <, > or =), then one line per rounding and per
   digit-value question; the digit asked about is underlined. #}
{% set compares = sheet.items | selectattr("task", "equalto", "compare") | list %}
{% set others = sheet.items | rejectattr("task", "equalto", "compare") | list %}
{% set place_word = {"whole": "a whole number", "tenth": "tenths", "hundredth": "hundredths"} %}
{% block style %}
.rows { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: repeat({{ (compares | length + 1) // 2 + others | length }}, 1fr); gap: 10px 18px; }
.rows .card { position: relative; min-height: 0; display: flex; align-items: center; justify-content: center; gap: 12px; padding: 0 12px 0 26px; border-radius: 18px; font-weight: 700; }
.rows .wide { grid-column: 1 / 3; justify-content: space-between; }
.qn { position: absolute; top: 6px; left: 12px; font-size: 13px; font-weight: 700; color: #8a8a90; }
.num { font-size: 36px; }
.circle { width: 48px; height: 48px; border: 3px solid var(--ink); border-radius: 50%; background: #fff; flex: none; }
.q { font-size: 30px; white-space: nowrap; }
.q u { text-decoration-thickness: 4px; text-underline-offset: 6px; text-decoration-color: var(--accent); }
.ans { width: 150px; height: 54px; border: 3px solid var(--ink); border-radius: 12px; background: #fff; flex: none; }
{% endblock %}
{% block body %}
    <div class="rows">
{% for i in compares %}
      <div class="card"><span class="qn" data-audience="parent">{{ i.n }}</span><span class="num">{{ i.a }}</span><span class="circle"></span><span class="num">{{ i.b }}</span></div>
{% endfor %}
{% if compares | length is odd %}
      <div></div>
{% endif %}
{% for i in others %}
      <div class="card wide"><span class="qn" data-audience="parent">{{ i.n }}</span>
{% if i.task == "round" %}
        <span class="q">Round {{ i.x }} to {{ place_word[i.place] }}</span>
{% else %}
        <span class="q">In {% for ch in i.x %}{% if loop.index0 == i.digit %}<u>{{ ch }}</u>{% else %}{{ ch }}{% endif %}{% endfor %}, the {{ i.x[i.digit] }} is worth</span>
{% endif %}
        <span class="ans"></span>
      </div>
{% endfor %}
    </div>
{% endblock %}
