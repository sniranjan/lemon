{% extends "base.html.j2" %}
{% block style %}
.cards { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 20px; }
.cards .card { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: 12px 28px; }
.cards .top { display: flex; align-items: center; gap: 26px; }
.cards img { width: 130px; height: 130px; flex: none; }
.cards .sentence { font-size: 46px; line-height: 1.2; }
/* handwriting rows: solid top line, dashed middle line, solid baseline */
.lines { display: flex; flex-direction: column; gap: 24px; }
.lines div { height: 72px; border-top: 2px solid #8a8a90; border-bottom: 3px solid var(--ink); position: relative; }
.lines div::after { content: ""; position: absolute; left: 0; right: 0; top: 35px; border-top: 2px dashed #9a9aa0; }
{% endblock %}
{% block body %}
    <div class="cards">
{% for item in sheet.items if item.kind == "copy" %}
      <div class="card">
        <div class="top"><img src="{{ root }}/assets/pictures/{{ item.picture }}.svg" alt=""><div class="sentence">{{ item.text }}</div></div>
        <div class="lines">{% for _ in range(item.rows) %}<div></div>{% endfor %}</div>
      </div>
{% endfor %}
    </div>
{% endblock %}
