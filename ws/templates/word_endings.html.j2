{% extends "base.html.j2" %}
{% block style %}
.cards { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 16px; }
.cards .card { flex: 1; min-height: 0; display: flex; align-items: center; gap: 24px; padding: 8px 26px; }
.cards .pics { flex: none; width: 150px; display: flex; justify-content: center; align-items: center; gap: 4px; }
.cards .pics img { width: 130px; height: 130px; }
.cards .pics.two img { width: 72px; height: 72px; }
.sum { flex: 1; min-width: 0; display: flex; align-items: center; gap: 14px; font-size: 40px; white-space: nowrap; }
.sum .tail { font-weight: 700; padding: 2px 14px; border: 3px solid var(--accent); border-radius: 14px; background: var(--tint); }
.sum .op { font-weight: 700; color: var(--accent); }
.sum i { display: block; flex: 1; min-width: 120px; height: 64px; border: 3px solid var(--ink); border-radius: 10px; }
{% endblock %}
{% block body %}
    <div class="cards">
{% for item in sheet.items if item.kind == "ending" %}
      <div class="card">
        <div class="pics{% if item.copies > 1 %} two{% endif %}">{% for _ in range(item.copies) %}<img src="{{ root }}/assets/pictures/{{ item.picture }}.svg" alt="">{% endfor %}</div>
        <div class="sum">
{% if item.mode == "add" %}
          <span>{{ item.word }}</span><span class="op">+</span><span class="tail">{{ item.tail }}</span><span class="op">=</span><i></i>
{% else %}
          <span>{{ item.form }}</span><span class="op">−</span><span class="tail">{{ item.tail }}</span><span class="op">=</span><i></i>
{% endif %}
        </div>
      </div>
{% endfor %}
    </div>
{% endblock %}
