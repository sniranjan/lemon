{% extends "base.html.j2" %}
{% block style %}
.trace { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 22px; }
.trace .card { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: center; gap: 18px; padding: 14px 28px; }
.trace .top { display: flex; align-items: center; gap: 24px; }
.trace .pics { flex: none; display: flex; gap: 6px; align-items: flex-end; height: 150px; }
.trace .pics img { width: 150px; height: 150px; }
.trace .pics.two img { width: 112px; height: 112px; }
.trace .pics img.size-little { width: 64px; height: 64px; }
.trace .sentence { flex: 1; min-width: 0; font-size: 44px; line-height: 1.2; }
.trace .sentence b { font-weight: 700; }
/* writing lines (in em of the trace size): top line just above the capitals, dashed middle line at the
   height of small letters, baseline; the sentence in light gray to trace. Long sentences take two lines. */
.trace .tlines { display: flex; flex-direction: column; gap: 0.3em; }
.trace .tline { position: relative; height: 0.8em; border-top: 2px solid #9a9aa0; border-bottom: 3px solid #6b6b70; }
.trace .tline::before { content: ""; position: absolute; left: 0; right: 0; bottom: 0.48em; border-top: 2px dashed #b5b5bb; }
.trace .ghost { position: absolute; left: 0.15em; bottom: -0.19em; line-height: 1; color: #bdbdc3; white-space: nowrap; word-spacing: 0.12em; }
.trace.long .card { gap: 10px; padding: 10px 28px; }
.trace.long .pics { height: 110px; }
.trace.long .pics img { width: 110px; height: 110px; }
.trace.long .pics.two img { width: 96px; height: 96px; }
.trace.long .sentence { font-size: 40px; }
{% endblock %}
{% block body %}
    <div class="trace{% if sheet.items | map(attribute="trace_lines") | map("length") | max > 1 %} long{% endif %}">
{% for item in sheet.items if item.kind == "sentence" %}
      <div class="card">
        <div class="top">
          <div class="pics{% if item.pictures | length > 1 %} two{% endif %}">{% for p in item.pictures %}<img src="{{ root }}/assets/pictures/{{ p }}.svg" alt=""{% if item.get("picture_size") %} class="size-{{ item.get("picture_size") }}"{% endif %}>{% endfor %}</div>
          <div class="sentence">{% for text, bold in item.runs %}{% if bold %}<b>{{ text }}</b>{% else %}{{ text }}{% endif %}{% endfor %}</div>
        </div>
        <div class="tlines" style="font-size: {{ item.trace_size }}px">{% for line in item.trace_lines %}<div class="tline"><div class="ghost">{{ line }}</div></div>{% endfor %}</div>
      </div>
{% endfor %}
    </div>
{% endblock %}
