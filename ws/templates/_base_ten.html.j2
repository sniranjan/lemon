{# Base-ten pictures for place value (Cubs math). Same orange as the tens bars in number_read.
   tens_ones: to scale, 13px squares: one bar of ten per ten, ones stacked beside them.
   hundreds_row / tens_ones_row: a "quick picture" for three-digit numbers: hundred squares
   (10×10 grid) in one row, then tens bars and ones (rows of five) in a row under them. #}
{% macro tens_ones(tens, ones) %}{% set s = 13 %}{% set w = tens * (s + 7) + (s + 4 if ones else 0) + 2 %}<svg viewBox="0 0 {{ w }} {{ 10 * s + 2 }}" width="{{ w }}" height="{{ 10 * s + 2 }}">{% for t in range(tens) %}{% for c in range(10) %}<rect x="{{ 1 + t * (s + 7) }}" y="{{ 1 + c * s }}" width="{{ s }}" height="{{ s }}" fill="#F4B184" stroke="#1d1d1f" stroke-width="2"/>{% endfor %}{% endfor %}{% for c in range(ones) %}<rect x="{{ 1 + tens * (s + 7) + 4 }}" y="{{ 1 + (9 - c) * s }}" width="{{ s }}" height="{{ s }}" fill="#F4B184" stroke="#1d1d1f" stroke-width="2"/>{% endfor %}</svg>{% endmacro %}
{% macro hundreds_row(hundreds) %}{% set f = 56 %}{% set w = hundreds * (f + 8) - 8 + 4 %}<svg viewBox="0 0 {{ w }} {{ f + 4 }}" width="{{ w }}" height="{{ f + 4 }}">{% for h in range(hundreds) %}{% set x = 2 + h * (f + 8) %}<rect x="{{ x }}" y="2" width="{{ f }}" height="{{ f }}" fill="#F4B184" stroke="#1d1d1f" stroke-width="3"/>{% for g in range(1, 10) %}<line x1="{{ x + g * f / 10 }}" y1="2" x2="{{ x + g * f / 10 }}" y2="{{ 2 + f }}" stroke="#1d1d1f" stroke-width="0.8"/><line x1="{{ x }}" y1="{{ 2 + g * f / 10 }}" x2="{{ x + f }}" y2="{{ 2 + g * f / 10 }}" stroke="#1d1d1f" stroke-width="0.8"/>{% endfor %}{% endfor %}</svg>{% endmacro %}
{% macro tens_ones_row(tens, ones) %}{% set f = 56 %}{% set rw = 12 %}{% set u = 12 %}{% set ow = 5 * (u + 3) %}{% set w = tens * (rw + 8) + (ow + 12 if ones else 0) + 4 %}<svg viewBox="0 0 {{ w }} {{ f + 4 }}" width="{{ w }}" height="{{ f + 4 }}">{% for t in range(tens) %}{% set x = 2 + t * (rw + 8) %}<rect x="{{ x }}" y="2" width="{{ rw }}" height="{{ f }}" fill="#F4B184" stroke="#1d1d1f" stroke-width="2.5"/>{% for g in range(1, 10) %}<line x1="{{ x }}" y1="{{ 2 + g * f / 10 }}" x2="{{ x + rw }}" y2="{{ 2 + g * f / 10 }}" stroke="#1d1d1f" stroke-width="1"/>{% endfor %}{% endfor %}{% set ox = 2 + tens * (rw + 8) + (4 if tens else 0) %}{% for c in range(ones) %}<rect x="{{ ox + (c % 5) * (u + 3) }}" y="{{ 2 + f - u - (c // 5) * (u + 3) }}" width="{{ u }}" height="{{ u }}" fill="#F4B184" stroke="#1d1d1f" stroke-width="2"/>{% endfor %}</svg>{% endmacro %}
