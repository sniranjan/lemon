{% extends "base.html.j2" %}
{% block style %}
.wb { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; }
.head-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.rules { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.rules span { font-size: 20px; border: 2px solid var(--accent); background: var(--tint); border-radius: 999px; padding: 2px 12px; white-space: nowrap; }
.rules b { color: var(--accent); }
.wb .card { flex: none; padding: 10px 26px 14px; display: flex; flex-direction: column; gap: 8px; }
.wb h2 { font-size: 22px; margin: 0; color: var(--accent); white-space: nowrap; }
.num { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--ink); color: #fff;
       display: inline-flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; }
.build { display: flex; align-items: center; gap: 12px; font-size: 26px; height: 44px; }
.build .piece { border: 2px solid #9a9aa0; border-radius: 12px; padding: 0 12px; line-height: 1.4; }
.build .piece.part { border-color: var(--accent); color: var(--accent); font-weight: 700; }
.build img { width: 44px; height: 44px; }
.build .blank { flex: 1; height: 36px; border-bottom: 2px solid #8a8a90; }
.row { display: grid; grid-template-columns: 30px 1fr; column-gap: 12px; align-items: start; font-size: 20px; line-height: 1.75; }
.row .num { margin-top: 3px; }
.row .choice { display: inline-flex; margin-left: 14px; white-space: nowrap; }
.row .picks { display: inline-block; white-space: nowrap; }
.row .pick { display: inline-block; margin-left: 10px; line-height: 1.3; }
.row b { font-size: 22px; }
.choices { display: flex; flex-wrap: wrap; column-gap: 22px; row-gap: 4px; margin: 4px 0 0 40px; font-size: 20px; }
.choice { display: flex; align-items: center; gap: 8px; }
.letter { flex: none; width: 32px; height: 32px; border: 2px solid var(--ink); border-radius: 50%;
          display: inline-flex; align-items: center; justify-content: center; font-weight: 700; }
.gap { display: inline-block; width: 110px; border-bottom: 2px solid var(--ink); }
.pick { border: 2px solid var(--ink); border-radius: 999px; padding: 0 14px; font-size: 20px; }
{% endblock %}
{% block body %}
{% set rule = sheet.items[0] %}
    <div class="wb">
      <section class="card builds">
        <div class="head-row"><h2>Build the word.</h2><div class="rules">{% for r in rule.parts %}<span><b>{{ r.show }}</b> = {{ r.means }}</span>{% endfor %}</div></div>
{% for i in sheet.items if i.kind == "build" %}
        <div class="build"><span class="num">{{ i.n }}</span>
{% if i.get("pictures") %}<img src="{{ root }}/assets/pictures/{{ i.pictures[0] }}.svg" alt="">{% endif %}
          <span class="piece{% if i.get("part") == "first" %} part{% endif %}">{{ i.first }}</span> +
{% if i.get("pictures") %}<img src="{{ root }}/assets/pictures/{{ i.pictures[1] }}.svg" alt="">{% endif %}
          <span class="piece{% if i.get("part") == "second" %} part{% endif %}">{{ i.second }}</span> = <span class="blank"></span></div>
{% endfor %}
      </section>
      <section class="card means">
        <h2>Circle the meaning.</h2>
{% for i in sheet.items if i.kind == "meaning" %}
        <div>
          <div class="row"><span class="num">{{ i.n }}</span><span><b>{{ i.built }}</b> means{% for c in i.choices %}<span class="choice"><span class="letter">{{ "ABC"[loop.index0] }}</span>{{ c }}</span>{% endfor %}</span></div>
        </div>
{% endfor %}
      </section>
      <section class="card fits">
        <h2>Circle the word that fits.</h2>
{% for i in sheet.items if i.kind == "sentence" %}
        <div>
          <div class="row"><span class="num">{{ i.n }}</span><span>{{ i.before }}<span class="gap"></span>{{ i.after }}<span class="picks">{% for o in i.options %}<span class="pick">{{ o }}</span>{% endfor %}</span></span></div>
        </div>
{% endfor %}
      </section>
    </div>
{% endblock %}
