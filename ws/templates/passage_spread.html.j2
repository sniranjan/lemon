{% extends "base.html.j2" %}
{# Two-page passages (ws/spreads.py): the reading page (passage alone, numbered paragraphs) or the
   questions page that follows it. #}
{% block style %}
h1 { font-size: 28px; }
.tip { padding: 8px 16px; }
.body { margin-top: 16px; }
.how { font-size: 20px; line-height: 24px; font-weight: 700; color: var(--accent); }
.read-wrap { flex: 1; min-height: 0; display: flex; flex-direction: column; margin-top: -6px; }
.read-wrap .how { margin-bottom: 6px; }
/* the reading page is the passage alone: no card, so a full grade 6 text fits at 20px */
.read { flex: 1; min-height: 0; border: none; border-radius: 0; padding: 0 0 0 36px; }
.read p { font-size: 20px; line-height: 1.27; margin: 0 0 6px; position: relative; }
.read .pn { position: absolute; left: -36px; width: 26px; text-align: right; font-weight: 700; color: var(--accent); }
.qs-how { margin: 0 0 4px; }
.turn { text-align: right; margin-top: 2px; }
.read.cont { flex: none; margin: 0 0 8px; padding-bottom: 6px; border-bottom: 3px solid var(--accent); }
.qs { flex: 1; min-height: 0; border: none; border-radius: 0; display: flex; flex-direction: column; justify-content: space-evenly; gap: 4px; }
.q .ask { font-size: 20px; font-weight: 700; line-height: 1.3; display: flex; gap: 10px; }
.q .num { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--ink); color: #fff;
          display: inline-flex; align-items: center; justify-content: center; font-size: 20px; }
.q .choices { display: flex; flex-direction: column; row-gap: 2px; margin: 3px 0 0 40px; font-size: 20px; line-height: 1.2; }
.q .choices.two { display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; }
.q .choice { display: flex; align-items: flex-start; gap: 10px; }
.q .letter { flex: none; width: 26px; height: 26px; border: 2px solid var(--ink); border-radius: 50%;
             display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 20px; }
.q .line { height: 34px; margin-left: 40px; border-bottom: 2px solid #8a8a90; }
.q .boxes { display: flex; gap: 12px; margin: 6px 0 0 40px; }
.q .box { flex: 1; border: 2px solid var(--ink); border-radius: 14px; padding: 0 12px 8px; }
.q .box .bh { font-size: 20px; font-weight: 700; color: var(--accent); padding-top: 4px; }
.q .box .line { margin-left: 0; height: 36px; }
{% endblock %}
{% block body %}
{% set head = sheet.items[0] %}
{% set what = "article" if head.genre == "nonfiction" else "story" %}
{% if head.side == "read" %}
    <section class="read-wrap">
      <div class="how">{% if head.again %}Read again: {{ head.look_for }}{% elif head.get("story") %}{{ head.story }}, part {{ head.part }}. The questions are on the next page.{% else %}Read the {{ what }}. The questions are on the next page.{% endif %}</div>
      <div class="card read">
{% for para in head.paragraphs %}
        <p>{% if para.n %}<span class="pn">{{ para.n }}</span>{% endif %}{{ para.text }}</p>
{% endfor %}
      </div>
{% if head.turn %}
      <div class="how turn">The {{ what }} continues on the next page. →</div>
{% endif %}
    </section>
{% else %}
{% if head.continued %}
    <div class="card read cont">
{% for para in head.continued %}
      <p>{% if para.n %}<span class="pn">{{ para.n }}</span>{% else %}<span class="pn">…</span>{% endif %}{{ para.text }}</p>
{% endfor %}
    </div>
    <div class="how qs-how">Now answer. Look back at page {{ head.page_before }} and the lines above.</div>
{% else %}
    <div class="how qs-how">Look back at the {{ what }} on page {{ head.page_before }} to answer.</div>
{% endif %}
    <div class="qs card">
{% for q in sheet.items[1:] %}
      <div class="q">
        <div class="ask"><span class="num">{{ q.n }}</span><span>{{ q.ask }}</span></div>
{% if q.kind in ("mc", "quote") %}
        <div class="choices{% if q.columns == 2 %} two{% endif %}">{% for c in q.choices %}<div class="choice"><span class="letter">{{ "ABCD"[loop.index0] }}</span><span>{% if q.kind == "quote" %}“{{ c }}”{% else %}{{ c }}{% endif %}</span></div>{% endfor %}</div>
{% elif q.kind == "organizer" %}
        <div class="boxes">{% for h in q.heads %}<div class="box"><div class="bh">{{ h }}</div>{% for _ in range(q.lines) %}<div class="line"></div>{% endfor %}</div>{% endfor %}</div>
{% else %}
{% for _ in range(q.lines) %}
        <div class="line"></div>
{% endfor %}
{% endif %}
      </div>
{% endfor %}
    </div>
{% endif %}
{% endblock %}
