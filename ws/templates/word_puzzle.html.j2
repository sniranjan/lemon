{% extends "base.html.j2" %}
{% block style %}
.ask { font-size: 30px; font-weight: 700; margin: 0 0 14px; }
.puzzles { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 16px; }
.puzzles .card { flex: 1; min-height: 0; display: flex; align-items: center; gap: 32px; padding: 6px 28px; }
.puzzles .pic { width: 118px; height: 118px; flex: none; }
.boxes { display: flex; gap: 8px; }
.box { width: 68px; height: 84px; border: 3px solid var(--ink); border-radius: 12px; display: flex; align-items: center;
       justify-content: center; font-size: 56px; font-weight: 700; line-height: 1; }
.box.empty { border: 3px dashed var(--accent); background: #fff; }
/* crosswords: clue pictures (with an arrow for across / down) on the left, squares on the right */
.puzzles .card.cross { justify-content: space-around; padding: 10px 40px; }
.clues { display: flex; flex-direction: column; gap: 18px; }
.clue { display: flex; align-items: center; gap: 12px; }
.clue img { width: 112px; height: 112px; }
.grid { display: grid; gap: 4px; }
.cell { width: 52px; height: 52px; }
.cell.sq { border: 3px solid var(--ink); border-radius: 8px; display: flex; align-items: center; justify-content: center;
           font-size: 36px; font-weight: 700; line-height: 1; background: #fff; }
.cell.sq.empty { border-style: dashed; border-color: var(--accent); }
{% endblock %}
{% block body %}
{% if sheet.items[0].kind == "missing" %}
    <p class="ask">Look at the picture. Write the missing letters.</p>
    <div class="puzzles">
{% for item in sheet.items %}
      <div class="card">
        <img class="pic" src="{{ root }}/assets/pictures/{{ item.picture }}.svg" alt="">
        <div class="boxes">{% for ch, shown in item.letters %}<div class="box{% if not shown %} empty{% endif %}">{% if shown %}{{ ch }}{% endif %}</div>{% endfor %}</div>
      </div>
{% endfor %}
    </div>
{% else %}
    <p class="ask">Write each picture's word in the squares.</p>
    <div class="puzzles">
{% for item in sheet.items %}
      <div class="card cross">
        <div class="clues">
          <div class="clue"><img src="{{ root }}/assets/pictures/{{ item.pictures[0] }}.svg" alt=""><svg viewBox="0 0 64 32" width="64" height="32" aria-hidden="true"><path d="M4 16 H50" stroke="#1d1d1f" stroke-width="5" stroke-linecap="round"/><path d="M40 5 L58 16 L40 27" fill="none" stroke="#1d1d1f" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <div class="clue"><img src="{{ root }}/assets/pictures/{{ item.pictures[1] }}.svg" alt=""><svg viewBox="0 0 32 64" width="32" height="64" aria-hidden="true"><path d="M16 4 V50" stroke="#1d1d1f" stroke-width="5" stroke-linecap="round"/><path d="M5 40 L16 58 L27 40" fill="none" stroke="#1d1d1f" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        </div>
        <div class="grid" style="grid-template-columns: repeat({{ item.grid[0] | length }}, 52px)">
{% for row in item.grid %}{% for cell in row %}{% if cell %}<div class="cell sq{% if not cell.given %} empty{% endif %}">{% if cell.given %}{{ cell.ch }}{% endif %}</div>{% else %}<div class="cell"></div>{% endif %}{% endfor %}
{% endfor %}
        </div>
      </div>
{% endfor %}
    </div>
{% endif %}
{% endblock %}
