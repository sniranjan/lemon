{% extends "base.html.j2" %}
{# Word problems: the story across the card, open space to work in, and a bottom row with the
   answer box and its unit. Equation problems put a line to write the equation on at the left of
   that row. #}
{% block style %}
.stories { flex: 1; min-height: 0; display: grid; grid-template-rows: repeat({{ sheet.items | length }}, 1fr); gap: 14px; }
.stories .card { position: relative; min-height: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; padding: 14px 22px 14px 34px; border-radius: 22px; }
.qn { position: absolute; top: 12px; left: 12px; font-size: 13px; font-weight: 700; color: #8a8a90; }
.story { font-size: 26px; line-height: 1.3; }
.bottom { display: flex; align-items: flex-end; gap: 24px; }
.eqline { flex: 1; display: flex; align-items: flex-end; gap: 10px; font-size: 24px; font-weight: 700; color: var(--accent); }
.eqline i { flex: 1; border-bottom: 2.5px solid var(--ink); height: 1.2em; }
.answer { margin-left: auto; display: flex; align-items: center; gap: 8px; font-size: 26px; font-weight: 700; white-space: nowrap; }
.ans { display: inline-block; width: 110px; height: 58px; border: 3px solid var(--ink); border-radius: 12px; background: #fff; flex: none; }
{% endblock %}
{% block body %}
    <div class="stories">
{% for p in sheet.items %}
      <div class="card"><span class="qn" data-audience="parent">{{ p.n }}</span>
        <div class="story">{{ p.text }}</div>
        <div class="bottom">
{% if p.equation %}
          <div class="eqline"><span>Equation:</span><i></i></div>
{% endif %}
          <div class="answer">{% if p.unit == "$" %}<span>$</span><span class="ans"></span>{% else %}<span class="ans"></span><span>{{ p.unit }}</span>{% endif %}</div>
        </div>
      </div>
{% endfor %}
    </div>
{% endblock %}
