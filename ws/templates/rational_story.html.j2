{% extends "base.html.j2" %}
{# Word problems: the story on the left, room to work on the right, and the answer box with its
   unit at the bottom. Equation problems add a line to write the equation on first. #}
{% block style %}
.stories { flex: 1; min-height: 0; display: grid; grid-template-rows: repeat({{ sheet.items | length }}, 1fr); gap: 14px; }
.stories .card { position: relative; min-height: 0; display: flex; align-items: stretch; gap: 18px; padding: 14px 20px 14px 34px; border-radius: 22px; }
.qn { position: absolute; top: 12px; left: 12px; font-size: 13px; font-weight: 700; color: #8a8a90; }
.story { flex: 1; font-size: 25px; line-height: 1.3; display: flex; flex-direction: column; justify-content: space-between; gap: 8px; }
.eqline { display: flex; align-items: flex-end; gap: 10px; font-size: 24px; font-weight: 700; }
.eqline i { flex: 1; border-bottom: 2.5px solid var(--ink); height: 1.2em; }
.work { width: 250px; display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-end; border-left: 2px dashed #b9b9be; padding-left: 14px; }
.answer { display: flex; align-items: center; gap: 8px; font-size: 24px; font-weight: 700; white-space: nowrap; }
.ans { display: inline-block; width: 96px; height: 60px; border: 3px solid var(--ink); border-radius: 12px; background: #fff; flex: none; }
{% endblock %}
{% block body %}
    <div class="stories">
{% for p in sheet.items %}
      <div class="card"><span class="qn" data-audience="parent">{{ p.n }}</span>
        <div class="story"><div>{{ p.text }}</div>
{% if p.equation %}
          <div class="eqline"><span>Equation:</span><i></i></div>
{% endif %}
        </div>
        <div class="work"><div class="answer">{% if p.unit == "$" %}<span>$</span><span class="ans"></span>{% else %}<span class="ans"></span><span>{{ p.unit }}</span>{% endif %}</div></div>
      </div>
{% endfor %}
    </div>
{% endblock %}
