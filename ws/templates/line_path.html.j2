{% extends "base.html.j2" %}
{% block style %}
.canvas { flex: 1; min-height: 0; display: flex; }
.canvas svg { width: 100%; height: 100%; }
{% endblock %}
{% macro marker(item, at) %}
        <circle cx="{{ at[0] }}" cy="{{ at[1] }}" r="{{ item.disc }}" fill="#fff" stroke="#1d1d1f" stroke-width="3"/>
{% if item.get('shape_path') %}
        <svg x="{{ at[0] - 28 }}" y="{{ at[1] - 28 }}" width="56" height="56" viewBox="-4 -4 108 108"><path d="{{ item.shape_path }}" fill="var(--tint)" stroke="#1d1d1f" stroke-width="3" stroke-linejoin="round" vector-effect="non-scaling-stroke"/></svg>
{% endif %}
{%- endmacro %}
{% block body %}
    <div class="canvas">
      <svg viewBox="0 0 704 680" preserveAspectRatio="xMidYMid meet">
{% for item in sheet.items %}
        <path d="{{ item.d }}" fill="none" stroke="#1d1d1f" stroke-width="{{ item.lane + 6 }}" stroke-linecap="round" stroke-linejoin="{{ item.get('join', 'round') }}"/>
        <path d="{{ item.d }}" fill="none" stroke="var(--tint)" stroke-width="{{ item.lane }}" stroke-linecap="round" stroke-linejoin="{{ item.get('join', 'round') }}"/>
{% if item.get('dot') %}
{{ marker(item, item.start) }}{% if item.get('picture') %}
        <image href="{{ root }}/assets/pictures/{{ item.picture }}.svg" x="{{ item.start[0] - item.size / 2 }}" y="{{ item.start[1] - item.size / 2 }}" width="{{ item.size }}" height="{{ item.size }}"/>
{% endif %}
{% endif %}
        <circle cx="{{ (item.get('dot') or item.start)[0] }}" cy="{{ (item.get('dot') or item.start)[1] }}" r="11" fill="#1d1d1f"/>
{% if item.get('shape_path') %}
{{ marker(item, item.end) }}{% else %}
        <circle cx="{{ item.end[0] }}" cy="{{ item.end[1] }}" r="{{ item.disc }}" fill="#fff" stroke="#1d1d1f" stroke-width="3"/>
        <image href="{{ root }}/assets/pictures/{{ item.target }}.svg" x="{{ item.end[0] - item.size / 2 }}" y="{{ item.end[1] - item.size / 2 }}" width="{{ item.size }}" height="{{ item.size }}"/>
{% endif %}
{% endfor %}
      </svg>
    </div>
{% endblock %}
