{% extends "base.html.j2" %}
{# Penguins Reading word roots (ws/roots.py): root cards, match words to meanings, fill blanks, explain. #}
{% block style %}
h1 { font-size: 28px; }
.wr { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; }
.cards { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
.chips { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; }
.chip { border: 3px solid var(--ink); border-radius: 16px; background: var(--tint); padding: 2px 14px; font-size: 20px; line-height: 1.35;
        display: flex; align-items: baseline; gap: 8px; }
.chip .root { font-size: 24px; font-weight: 700; color: var(--accent); }
.chip .origin { margin-left: auto; font-style: italic; color: #3a3a40; }
.rc { border: 3px solid var(--ink); border-radius: 22px; padding: 8px 18px 10px; background: var(--tint); }
.rc .top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
.rc .root { font-size: 36px; font-weight: 700; color: var(--accent); line-height: 1.1; }
.rc .origin { font-size: 20px; font-style: italic; color: #3a3a40; }
.rc .means { font-size: 20px; line-height: 1.25; }
.rc .eg { font-size: 20px; color: #3a3a40; }
.task { flex: none; border: 3px solid var(--ink); border-radius: 22px; padding: 6px 22px 10px; }
.task h2 { font-size: 20px; margin: 0 0 6px; display: flex; align-items: center; gap: 10px; }
.num { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--ink); color: #fff;
       display: inline-flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; }
.match { display: grid; grid-template-columns: 1fr 1.6fr; column-gap: 26px; row-gap: 4px; font-size: 20px; }
.match .w { display: flex; align-items: center; gap: 10px; font-weight: 700; }
.match .box { flex: none; width: 36px; height: 32px; border: 2px solid var(--ink); border-radius: 8px; }
.match .m { display: flex; align-items: center; gap: 10px; line-height: 1.2; }
.letter { flex: none; width: 28px; height: 28px; border: 2px solid var(--ink); border-radius: 50%;
          display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 20px; }
.bank { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 6px; }
.bank span { font-size: 20px; border: 2px solid var(--accent); border-radius: 999px; padding: 0 14px; font-weight: 700; }
.sent { font-size: 20px; line-height: 1.6; }
.gap { display: inline-block; width: 150px; border-bottom: 2px solid var(--ink); }
.ask { font-size: 20px; line-height: 1.3; }
.ask b { color: var(--accent); }
.line { height: 36px; border-bottom: 2px solid #8a8a90; }
{% endblock %}
{% block body %}
{% set head = sheet.items[0] %}
    <div class="wr">
{% if head.review %}
      <div class="chips">
{% for r in head.roots %}
        <div class="chip"><span class="root">{{ r.root }}</span><span>{{ r.meaning }}</span><span class="origin">{{ r.origin }}</span></div>
{% endfor %}
      </div>
{% else %}
      <div class="cards">
{% for r in head.roots %}
        <div class="rc"><div class="top"><span class="root">{{ r.root }}</span><span class="origin">{{ r.origin }}</span></div>
          <div class="means">means <b>{{ r.meaning }}</b></div><div class="eg">as in {{ r.example }}</div></div>
{% endfor %}
      </div>
{% endif %}
{% for i in sheet.items[1:] %}
{% if i.kind == "match" %}
      <section class="task">
        <h2><span class="num">{{ i.n }}</span>Write the letter of each word's meaning.</h2>
        <div class="match">
{% for w in i.words %}
          <div class="w"><span class="box"></span>{{ w }}</div><div class="m"><span class="letter">{{ "ABCD"[loop.index0] }}</span>{{ i.meanings[loop.index0] }}</div>
{% endfor %}
        </div>
      </section>
{% elif i.kind == "fill" %}
      <section class="task">
        <h2><span class="num">{{ i.n }}</span>Write a word from the box in each blank.</h2>
        <div class="bank">{% for w in i.bank %}<span>{{ w }}</span>{% endfor %}</div>
{% for s in i.sentences %}
        <div class="sent">{{ "abcd"[loop.index0] }}. {{ s.before }}<span class="gap"></span>{{ s.after }}</div>
{% endfor %}
      </section>
{% endif %}
{% endfor %}
{% set explains = sheet.items|selectattr("kind", "equalto", "explain")|list %}
      <section class="task">
        <h2><span class="num">{{ explains[0].n }}</span>Use the root to explain the word.</h2>
{% for i in explains %}
        <div class="ex">
          <div class="ask">What does <b>{{ i.explain_word }}</b> mean? How does the root <b>{{ i.root }}</b> (“{{ i.meaning }}”) help?</div>
{% for _ in range(i.lines) %}
          <div class="line"></div>
{% endfor %}
        </div>
{% endfor %}
      </section>
    </div>
{% endblock %}
