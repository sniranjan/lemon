{% extends "base.html.j2" %}
{% import "_algebra.html.j2" as alg with context %}
{# Solve and graph: each card has the inequality and "x ____" on one row, then an empty number line
   from −10 to 10 (labels at −10, −5, 0, 5, 10) for the dot and the shading. #}
{% set L, SP, X0 = 10, 29, 22 %}
{% block style %}
{{ alg.styles() }}
.ex { font-size: 36px; }
.probs { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr; grid-auto-rows: 1fr; gap: 12px; }
.probs .card { position: relative; min-height: 0; display: flex; flex-direction: column; justify-content: center; gap: 2px; padding: 4px 20px 4px 34px; border-radius: 22px; }
.card .qn { position: absolute; top: 10px; left: 14px; }
.top { display: flex; align-items: center; gap: 24px; }
.ans { flex: 1; display: flex; align-items: flex-end; }
.ans .v { font-size: 34px; font-weight: 700; }
svg.nl text { font-family: "Andika", sans-serif; font-weight: 700; fill: #1d1d1f; }
{% endblock %}
{% block body %}
    <p class="ask">Solve. Then show the answers on the number line.</p>
    <div class="probs">
{% for i in sheet.items %}
      <div class="card"><span class="qn" data-audience="parent">{{ i.n }}</span>
        <div class="top"><span class="ex">{{ i.lhs | alg }} {{ i.show }} {{ i.rhs | alg }}</span><span class="ans"><span class="v">x</span><span class="line" style="margin-left: 10px"></span></span></div>
        <svg class="nl" width="{{ X0 * 2 + 2 * L * SP }}" height="62" viewBox="0 0 {{ X0 * 2 + 2 * L * SP }} 62">
          <line x1="{{ X0 - 14 }}" x2="{{ X0 + 2 * L * SP + 14 }}" y1="16" y2="16" stroke="#1d1d1f" stroke-width="3"/>
          <path d="M{{ X0 - 16 }},16 l10,-7 v14 z M{{ X0 + 2 * L * SP + 16 }},16 l-10,-7 v14 z" fill="#1d1d1f"/>
{% for k in range(-L, L + 1) %}
          <line x1="{{ X0 + (k + L) * SP }}" x2="{{ X0 + (k + L) * SP }}" y1="{{ 6 if k % 5 == 0 else 9 }}" y2="{{ 26 if k % 5 == 0 else 23 }}" stroke="#1d1d1f" stroke-width="{{ 3 if k % 5 == 0 else 2 }}"/>
{% if k % 5 == 0 %}
          <text x="{{ X0 + (k + L) * SP }}" y="56" text-anchor="middle" style="font-size: 28px">{{ k | string | minus }}</text>
{% endif %}
{% endfor %}
        </svg>
      </div>
{% endfor %}
    </div>
{% endblock %}
