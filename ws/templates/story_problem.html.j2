{% extends "base.html.j2" %}
{% block style %}
.stories { flex: 1; min-height: 0; display: grid; grid-template-rows: repeat({{ sheet.items | length }}, 1fr); gap: 14px; }
.stories .card { position: relative; min-height: 0; display: flex; align-items: stretch; gap: 20px; padding: 16px 22px 16px 34px; border-radius: 22px; }
.qn { position: absolute; top: 12px; left: 12px; font-size: 13px; font-weight: 700; color: #8a8a90; }
.story { flex: 1; font-size: 28px; line-height: 1.3; }
.work { width: 250px; display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-end; border-left: 2px dashed #b9b9be; padding-left: 16px; }
.answer { display: flex; align-items: center; gap: 10px; font-size: 28px; font-weight: 700; white-space: nowrap; }
.ans { display: inline-block; width: 84px; height: 58px; border: 3px solid var(--ink); border-radius: 12px; background: #fff; flex: none; }
{% endblock %}
{% block body %}
    <div class="stories">
{% for p in sheet.items %}
      <div class="card"><span class="qn" data-audience="parent">{{ p.n }}</span>
        <div class="story">{{ p.text }}</div>
        <div class="work"><div class="answer"><span class="ans"></span><span>{{ p.unit }}</span></div></div>
      </div>
{% endfor %}
    </div>
{% endblock %}
