{% extends "base.html.j2" %}
{# Fraction friends. Fractions are stacked (top, bar, bottom); empty boxes are what the child writes.
   Bars are SVG rectangles cut into equal parts from whole numbers only: part k of p sits at W * k / p.
   Shaded parts are mid-gray, added parts are striped, taken-away parts are crossed out. #}
{% set W, H = 400, 44 %}
{% macro fr(top, bottom, blank=none) %}<span class="fr">{% if blank == "num" %}<span class="box"></span>{% else %}<span>{{ top }}</span>{% endif %}<span class="line"></span>{% if blank == "den" or blank == "both" %}<span class="box"></span>{% else %}<span>{{ bottom }}</span>{% endif %}</span>{% endmacro %}
{% macro answer() %}<span class="fr"><span class="box"></span><span class="line"></span><span class="box"></span></span>{% endmacro %}
{% macro bar(parts, shaded, striped=0, crossed=0) %}<svg class="fbar" width="{{ W + 4 }}" height="{{ H + 4 }}" viewBox="-2 -2 {{ W + 4 }} {{ H + 4 }}">
{% for k in range(parts) %}{% set x = (W * k / parts) | round(2) %}{% set w = (W / parts) | round(2) %}
<rect x="{{ x }}" y="0" width="{{ w }}" height="{{ H }}" fill="{% if k < shaded %}#a3a3a8{% elif k < shaded + striped %}url(#stripes){% else %}#fff{% endif %}" stroke="#1d1d1f" stroke-width="3"/>{% if k >= shaded - crossed and k < shaded %}<path d="M{{ x + 6 }} 6 L{{ x + w - 6 }} {{ H - 6 }} M{{ x + w - 6 }} 6 L{{ x + 6 }} {{ H - 6 }}" stroke="#1d1d1f" stroke-width="3.5" stroke-linecap="round"/>{% endif %}
{% endfor %}</svg>{% endmacro %}
{% block style %}
.probs { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 1fr; gap: 14px 20px; }
.probs .card { position: relative; min-height: 0; display: flex; align-items: center; justify-content: center; gap: 26px; padding: 8px 18px; border-radius: 22px; }
.probs .wide { grid-column: 1 / -1; justify-content: space-between; padding: 8px 30px; }
.qn { position: absolute; top: 8px; left: 14px; font-size: 13px; font-weight: 700; color: #8a8a90; }
.bars { display: flex; flex-direction: column; gap: 14px; }
.eq { display: flex; align-items: center; gap: 14px; font-size: 40px; font-weight: 700; }
.fr { display: inline-flex; flex-direction: column; align-items: center; font-size: 40px; font-weight: 700; line-height: 1.05; }
.fr .line { width: 52px; border-top: 4px solid var(--ink); margin: 4px 0; }
.fr .box { width: 50px; height: 44px; border: 3px solid var(--ink); border-radius: 9px; }
{% endblock %}
{% block body %}
    <svg width="0" height="0" style="position: absolute"><defs><pattern id="stripes" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="10" height="10" fill="#fff"/><rect width="4" height="10" fill="#6b6b70"/></pattern></defs></svg>
    <div class="probs">
{% for i in sheet.items %}
{% if i.kind == "bars" %}
      <div class="card wide"><span class="qn" data-audience="parent">{{ i.n_ }}</span>
        <div class="bars">{{ bar(i.b, i.a) }}{{ bar(i.b * i.n, i.a * i.n) }}</div>
        <div class="eq">{{ fr(i.a, i.b) }}<span>=</span>{{ fr(none, i.b * i.n, "num") }}</div>
      </div>
{% elif i.kind == "equiv" %}
      <div class="card"><span class="qn" data-audience="parent">{{ i.n_ }}</span>
        <div class="eq">{{ fr(i.left[0], i.left[1]) }}<span>=</span>{{ fr(i.right[0], i.right[1], i.blank) }}</div>
      </div>
{% else %}
      <div class="card{% if i.bar %} wide{% endif %}"><span class="qn" data-audience="parent">{{ i.n_ }}</span>
{% if i.bar %}
        {{ bar(i.den, i.a, i.c if i.op == "add" else 0, i.c if i.op == "sub" else 0) }}
{% endif %}
        <div class="eq">{{ fr(i.a, i.den) }}<span>{{ "+" if i.op == "add" else "−" }}</span>{{ fr(i.c, i.den) }}<span>=</span>{{ answer() }}</div>
      </div>
{% endif %}
{% endfor %}
    </div>
{% endblock %}
