{% extends "base.html.j2" %}
{% block style %}
.shapes { flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: space-evenly; }
.shapes svg.large { width: 540px; height: 540px; }
.shapes svg.medium { width: 330px; height: 330px; }
{% endblock %}
{% block body %}
    <div class="shapes">
{% for item in sheet.items %}
      <svg class="{{ item.size }}" viewBox="-4 -4 108 108"><path d="{{ item.path }}" fill="none" stroke="#1d1d1f" stroke-width="8" stroke-linejoin="round" vector-effect="non-scaling-stroke"/></svg>
{% endfor %}
    </div>
{% endblock %}
