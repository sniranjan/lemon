{% extends "base.html.j2" %}
{% block style %}
.stack { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 20px; }
.stack .card { flex: 1; min-height: 0; display: flex; align-items: center; gap: 32px; padding: 12px 32px; }
/* the picture is 280px but gives way (down to 200px) to long words; the word never shrinks */
.stack .card img { flex: 0 1 280px; width: 280px; min-width: 200px; max-height: 100%; aspect-ratio: 1; object-fit: contain; }
.stack .card .word { flex: none; font-size: 96px; font-weight: 700; line-height: 1; }
{% endblock %}
{% block body %}
    <div class="stack">
{% for item in sheet.items if item.kind == "card" %}
      <div class="card"><img src="{{ root }}/assets/pictures/{{ item.picture }}.svg" alt=""><div class="word">{{ item.word }}</div></div>
{% endfor %}
    </div>
{% endblock %}
{% block after_body %}
{% include "_say_it_again.html.j2" %}
{% endblock %}
