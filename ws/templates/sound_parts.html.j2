{% extends "base.html.j2" %}
{% block style %}
.sp { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 20px; }
.sp .card { flex: 1; min-height: 0; display: flex; align-items: center; gap: 30px; padding: 12px 30px; }
.sp img { flex: none; width: 180px; height: 180px; }
.sp.two img { width: 220px; height: 220px; }
.sp .right { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
/* the two sound parts, each in its own box; the part to listen for is bold and in the subject color */
.sp .parts { display: flex; gap: 14px; }
.sp .parts span { font-size: 76px; line-height: 1; padding: 10px 24px 16px; border: 3px solid #9a9aa0; border-radius: 18px; min-width: 96px; text-align: center; }
.sp .parts .key { font-weight: 700; color: var(--accent); border-color: var(--accent); border-width: 4px; }
.sp .whole { font-size: 60px; font-weight: 700; line-height: 1; }
{% endblock %}
{% block body %}
{% set rhyme = sheet.title == "Words that rhyme" %}
    <div class="sp{% if sheet.items | length == 2 %} two{% endif %}">
{% for item in sheet.items %}
      <div class="card">
        <img src="{{ root }}/assets/pictures/{{ item.picture }}.svg" alt="">
        <div class="right">
          <div class="parts"><span{% if not rhyme %} class="key"{% endif %}>{{ item.onset }}</span><span{% if rhyme %} class="key"{% endif %}>{{ item.rime }}</span></div>
          <div class="whole">{{ item.word }}</div>
        </div>
      </div>
{% endfor %}
    </div>
{% endblock %}
