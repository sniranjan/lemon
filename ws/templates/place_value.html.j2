{% extends "base.html.j2" %}
{% from "_base_ten.html.j2" import tens_ones, hundreds_row, tens_ones_row %}
{% set mode = sheet.items[0].kind %}
{% block style %}
.lines { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 14px; }
.lines .card { flex: 1; min-height: 0; display: flex; align-items: center; padding: 4px 28px; }
.say { display: flex; align-items: center; flex-wrap: nowrap; gap: 8px; font-size: 30px; font-weight: 700; white-space: nowrap; }
.say .big { font-size: 44px; }
.box { display: inline-block; width: 56px; height: 60px; border: 3px solid var(--ink); border-radius: 10px; flex: none; }
.box.wide { width: 120px; }
.box.num { width: 120px; height: 60px; }
.pic { display: flex; flex-direction: column; gap: 8px; }
.lines .card.blocks2 { justify-content: space-between; }
.lines .card.blocks3 { padding: 4px 20px; flex-direction: column; align-items: flex-start; justify-content: center; gap: 10px; }
.example { display: flex; justify-content: center; gap: 48px; font-size: 32px; font-weight: 700; color: var(--accent); background: var(--tint); border: 2px solid var(--accent); border-radius: 18px; padding: 8px 0; margin-bottom: 18px; }
.cmp { display: flex; align-items: center; justify-content: center; gap: 36px; width: 100%; font-size: 54px; line-height: 1; font-weight: 700; }
.circle { width: 70px; height: 70px; border: 3px solid var(--ink); border-radius: 50%; }
.name { font-size: 32px; }
{% endblock %}
{% block body %}
{% if mode == "compare" %}
    <div class="example"><span>25 &lt; 52</span><span>52 &gt; 25</span><span>25 = 25</span></div>
{% endif %}
    <div class="lines">
{% for item in sheet.items %}
{% if item.kind == "blocks" and item.width == 2 %}
      <div class="card blocks2"><div class="pic">{{ tens_ones(item.places[0], item.places[1]) }}</div>
        <div class="say"><span class="box"></span><span>tens</span><span class="box"></span><span>ones</span><span>=</span><span class="box num"></span></div></div>
{% elif item.kind == "blocks" %}
      <div class="card blocks3"><div class="pic">{{ hundreds_row(item.places[0]) }}{{ tens_ones_row(item.places[1], item.places[2]) }}</div>
        <div class="say"><span class="box"></span><span>hundreds</span><span class="box"></span><span>tens</span><span class="box"></span><span>ones</span><span>=</span><span class="box num"></span></div></div>
{% elif item.kind == "expanded" %}
      <div class="card"><div class="say">
{% if item.form == "parts_to_number" %}
        <span class="big">{{ item.parts | join(" + ") }}</span><span class="big">=</span><span class="box num"></span>
{% elif item.form == "number_to_parts" %}
        <span class="big">{{ item.n }}</span><span class="big">=</span>{% for p in item.parts %}{% if not loop.first %}<span class="big">+</span>{% endif %}<span class="box wide"></span>{% endfor %}
{% elif item.form == "units_to_number" %}
        {% for u in item.units %}<span class="big">{{ u.count }}</span><span>{{ u.name }}</span>{% endfor %}<span class="big">=</span><span class="box num"></span>
{% else %}
        <span class="name">{{ item.name }}</span><span class="big">=</span><span class="box num"></span>
{% endif %}
      </div></div>
{% else %}
      <div class="card"><div class="cmp"><span>{{ item.left }}</span><span class="circle"></span><span>{{ item.right }}</span></div></div>
{% endif %}
{% endfor %}
    </div>
{% endblock %}
