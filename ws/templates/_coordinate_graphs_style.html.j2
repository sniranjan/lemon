.graphs { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 1fr; gap: 12px 14px; }
.graphs .card { position: relative; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 6px 10px; border-radius: 22px; }
.graphs .qn { position: absolute; top: 10px; left: 14px; font-size: 15px; font-weight: 700; color: #8a8a90; }
.graphs .eqn { font-size: 32px; font-weight: 700; white-space: nowrap; line-height: 1.2; }
.graphs .frac { display: inline-flex; flex-direction: column; align-items: center; vertical-align: middle; font-size: 28px; line-height: 1.05; margin: 0 2px; }
.graphs .frac .top { border-bottom: 2.5px solid var(--ink); padding: 0 3px; }
svg.small text { font-family: "Andika", sans-serif; font-weight: 700; fill: #1d1d1f; paint-order: stroke; stroke: #fff; stroke-width: 5px; stroke-linejoin: round; }
.ask { font-size: 28px; font-weight: 700; margin: 0 0 12px; }
