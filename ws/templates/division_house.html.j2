{% extends "base.html.j2" %}
{# Long division house. One grid column per digit of the number being shared: answer boxes on the roof
   over the digits they come from (from `start` on), the divisor outside on the left, and squared work
   space under the digits for the multiply and take-away steps. #}
{% set n = sheet.items | length %}
{% block style %}
.problems { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(2, 1fr); grid-auto-rows: 1fr; gap: 20px 24px; }
.problems .card { min-height: 0; display: flex; justify-content: center; padding: 14px 10px 12px; border-radius: 24px; }
.div { display: grid; grid-template-columns: 50px repeat(var(--digits), 44px) 84px; grid-template-rows: auto auto 1fr; align-items: end; }
.q { width: 38px; height: 46px; border: 3px solid var(--ink); border-radius: 9px; justify-self: center; margin-bottom: 6px; }
.rem { display: flex; align-items: center; gap: 6px; padding-left: 10px; margin-bottom: 6px; font-size: 30px; font-weight: 700; }
.rem .q { margin: 0; }
.divisor { font-size: 46px; font-weight: 700; line-height: 56px; text-align: right; padding-right: 10px; }
.house { grid-column: 2 / span var(--digits); display: grid; grid-template-columns: repeat(var(--digits), 44px);
         border-top: 4px solid var(--ink); border-left: 4px solid var(--ink); border-top-left-radius: 4px 0; margin-left: -4px;
         border-bottom-left-radius: 22px 56px; }
.house span { padding-left: 4px; font-size: 46px; font-weight: 700; line-height: 56px; text-align: center; }
.work { grid-column: 2 / span var(--digits); align-self: stretch; margin-top: 8px; min-height: 0;
        background-image: linear-gradient(to right, #c4c4ca 1.5px, transparent 1.5px), linear-gradient(to bottom, #c4c4ca 1.5px, transparent 1.5px);
        background-size: 44px 34px; border-right: 1.5px solid #c4c4ca; border-bottom: 1.5px solid #c4c4ca; }
{% if n <= 2 %}
/* two big problems a page: square work cells */
.work { background-size: 44px 44px; }
{% endif %}
{% if sheet.items | selectattr("divisor", "ge", 10) | list %}
/* two-digit divisors (Otters): a wider divisor column, narrower digit columns so 4 digits still fit */
.div.wide { grid-template-columns: 68px repeat(var(--digits), 40px) 74px; }
.div.wide .house { grid-template-columns: repeat(var(--digits), 40px); }
.div.wide .work { background-size: 40px 34px; }
{% endif %}
{% endblock %}
{% block body %}
    <div class="problems">
{% for item in sheet.items %}
{% set s = item.dividend | string %}
{% set digits = s | length %}
      <div class="card"><div class="div{% if item.divisor >= 10 %} wide{% endif %}" style="--digits: {{ digits }}">
        <span></span>{% for c in range(digits) %}{% if c >= item.start %}<span class="q"></span>{% else %}<span></span>{% endif %}{% endfor %}<span>{% if item.r_box %}<span class="rem">R <span class="q"></span></span>{% endif %}</span>
        <span class="divisor">{{ item.divisor }}</span><div class="house">{% for ch in s %}<span>{{ ch }}</span>{% endfor %}</div><span></span>
        <span></span><div class="work"></div><span></span>
      </div></div>
{% endfor %}
    </div>
{% endblock %}
