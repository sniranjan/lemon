{% extends "base.html.j2" %}
{% block style %}
.tracks { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 22px; }
.tracks .card { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; padding: 12px 14px; }
.track { display: flex; gap: 5px; }
.box { width: 62px; height: 88px; border: 3px solid var(--ink); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 36px; font-weight: 700; line-height: 1; }
.box.first { background: var(--tint); border-color: var(--accent); }
.box.gap { border: 3px dashed var(--accent); background: #fff; }
{% endblock %}
{% block body %}
    <div class="tracks">
{% for item in sheet.items %}
      <div class="card"><div class="track">{% for n in item.cells %}{% if loop.index0 in item.gaps %}<div class="box gap"></div>{% else %}<div class="box{% if loop.first %} first{% endif %}">{{ n }}</div>{% endif %}{% endfor %}</div></div>
{% endfor %}
    </div>
{% endblock %}
