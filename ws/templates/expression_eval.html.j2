{% extends "base.html.j2" %}
{# Letters for numbers. power: "2³ + 5 = ☐"; write: a phrase and a long box for the expression;
   substitute: "if n = 5" over "3n + 4 = ☐"; formula: the formula, the letters' values, "A = ☐".
   Letters are italic, as in a math book. #}
{% set task = sheet.items[0].task %}
{% macro math(s) %}{% for ch in s %}{% if ch in "abcdefghijklmnopqrstuvwxyz" %}<i>{{ ch }}</i>{% else %}{{ ch }}{% endif %}{% endfor %}{% endmacro %}
{% block style %}
.probs { flex: 1; min-height: 0; display: grid; gap: 14px 18px; grid-auto-rows: 1fr;
         grid-template-columns: {{ "1fr" if task == "write" else "1fr 1fr" }}; }
.probs .card { position: relative; min-height: 0; display: flex; flex-direction: {{ "row" if task in ("power", "write") else "column" }}; align-items: {{ "center" if task in ("power", "write") else "flex-start" }}; justify-content: center; gap: 10px 16px; padding: 8px 20px 8px 34px; border-radius: 22px; }
.qn { position: absolute; top: 10px; left: 12px; font-size: 13px; font-weight: 700; color: #8a8a90; }
.ex { display: flex; align-items: center; gap: 10px; font-size: 30px; font-weight: 700; white-space: nowrap; }
.ex i, .given i { font-family: "Andika", serif; font-style: italic; }
.given { font-size: 24px; color: var(--accent); font-weight: 700; white-space: nowrap; }
.phrase { flex: 1; font-size: 28px; }
.box { display: inline-block; width: 86px; height: 56px; border: 3px solid var(--ink); border-radius: 10px; background: #fff; flex: none; }
.box.long { width: 230px; }
{% endblock %}
{% block body %}
    <div class="probs">
{% for i in sheet.items %}
      <div class="card"><span class="qn" data-audience="parent">{{ i.n }}</span>
{% if task == "power" %}
        <div class="ex"><span>{{ math(i.show) }} =</span><span class="box"></span></div>
{% elif task == "write" %}
        <div class="phrase">{{ i.phrase }}</div><span class="box long"></span>
{% elif task == "substitute" %}
        <div class="given">if {{ math(i.letter) }} = {{ i.vars[i.letter] }}</div>
        <div class="ex"><span>{{ math(i.show) }} =</span><span class="box"></span></div>
{% else %}
        <div class="given">{% for k, v in i.vars.items() %}{{ math(k) }} = {{ v }}{% if not loop.last %},&nbsp; {% endif %}{% endfor %}</div>
        <div class="ex"><span>{% if i.name %}{{ math(i.name) }} = {% endif %}{{ math(i.show) }} =</span><span class="box"></span></div>
{% endif %}
      </div>
{% endfor %}
    </div>
{% endblock %}
