{% extends "base.html.j2" %}
{# Vertical problems. Every number is right-aligned in `cols` digit columns, with the sign in its
   own column on the left. Regrouping parts get dashed boxes above the columns: adding, one above
   each column a carry can land in; taking away, one above each digit of the top number. #}
{% set n = sheet.items | length %}
{% set per_row = 3 if n == 6 else 2 %}
{% block style %}
.problems { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat({{ per_row }}, 1fr); grid-auto-rows: 1fr; gap: 24px; }
.problems .card { min-height: 0; display: flex; align-items: center; justify-content: center; padding: 12px; }
.sum { display: grid; grid-template-columns: 44px repeat(var(--cols), 46px); column-gap: 3px; align-items: center; justify-items: center; }
.d { font-size: 54px; font-weight: 700; line-height: 64px; height: 64px; }
.sign { font-size: 50px; font-weight: 700; line-height: 64px; }
.carry { width: 40px; height: 38px; border: 2px dashed var(--accent); border-radius: 8px; margin-bottom: 4px; }
.rule { grid-column: 1 / -1; justify-self: stretch; height: 0; border-top: 4px solid var(--ink); margin: 6px 0 10px; }
.ans { width: 44px; height: 60px; border: 3px solid var(--ink); border-radius: 10px; }
{% endblock %}
{% block body %}
    <div class="problems">
{% for item in sheet.items %}
{% set cols = item.cols %}
      <div class="card"><div class="sum" style="--cols: {{ cols }}">
{% if item.boxes %}
        <span></span>{% for c in range(cols) %}{% set col = cols - 1 - c %}{% if (item.op == "add" and col >= 1) or (item.op == "sub" and col < (item.numbers[0] | string | length)) %}<span class="carry"></span>{% else %}<span></span>{% endif %}{% endfor %}

{% endif %}
{% for num in item.numbers %}
{% set s = num | string %}
        <span class="sign">{% if not loop.first %}{{ item.sign }}{% endif %}</span>{% for c in range(cols) %}{% set k = c - (cols - s | length) %}<span class="d">{% if k >= 0 %}{{ s[k] }}{% endif %}</span>{% endfor %}

{% endfor %}
        <span class="rule"></span>
        <span></span>{% for c in range(cols) %}<span class="ans"></span>{% endfor %}

      </div></div>
{% endfor %}
    </div>
{% endblock %}
