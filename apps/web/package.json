{
  "name": "@paperlessons/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sync && vite",
    "build": "npm run sync && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler d1 migrations apply paperlessons --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply paperlessons --local",
    "typecheck": "npm run sync && tsc --noEmit",
    "sync": "node scripts/sync-pictures.mjs && node scripts/sync-ladder.mjs",
    "test": "npm run sync && vitest run"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/gochi-hand": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@openreplay/tracker": "17.2.11",
    "@pdf-lib/fontkit": "1.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.5.2",
    "hono": "4.13.16",
    "lucide-react": "1.69.0",
    "pdf-lib": "1.17.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "pdfjs-dist": "4.10.38",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0",
    "yaml": "^2.9.1"
  }
}
